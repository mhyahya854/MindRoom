{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "registrationId",
    "registrationType",
    "declaringPath",
    "declaringSymbol",
    "lineRange",
    "registeredIdentifier",
    "implementationPaths",
    "consumerPaths",
    "runtimeEntrypoints",
    "consumerDiscoveryStatus",
    "consumerSearchEvidence",
    "capabilityDiscoveryStatus",
    "capabilitySearchEvidence",
    "entrypointDiscoveryStatus",
    "entrypointSearchEvidence",
    "capabilityIds",
    "classification",
    "removalRisk",
    "evidence",
    "reviewStatus",
    "runId"
  ],
  "properties": {
    "registrationId": {"type": "string", "pattern": "^MR-REG-"},
    "registrationType": {"type": "string", "minLength": 1},
    "declaringPath": {"type": "string", "pattern": "^Codebase/"},
    "declaringSymbol": {"type": "string"},
    "lineRange": {"type": "string", "minLength": 1},
    "registeredIdentifier": {"type": "string", "minLength": 1},
    "implementationPaths": {"type": "array", "items": {"type": "string", "pattern": "^Codebase/"}},
    "consumerPaths": {"type": "array", "items": {"type": "string", "pattern": "^Codebase/"}},
    "runtimeEntrypoints": {"type": "array", "items": {"type": "string", "pattern": "^Codebase/"}},
    "consumerDiscoveryStatus": {"type": "string", "minLength": 1},
    "consumerSearchEvidence": {"type": "array", "minItems": 1},
    "capabilityDiscoveryStatus": {"type": "string", "minLength": 1},
    "capabilitySearchEvidence": {"type": "array", "minItems": 1},
    "entrypointDiscoveryStatus": {"type": "string", "minLength": 1},
    "entrypointSearchEvidence": {"type": "array", "minItems": 1},
    "capabilityIds": {"type": "array", "items": {"type": "string"}},
    "classification": {"type": "string", "minLength": 1},
    "removalRisk": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "minItems": 1},
    "reviewStatus": {"type": "string", "minLength": 1},
    "runId": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
